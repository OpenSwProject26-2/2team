{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "busstrike/confirm/1",
  "title": "운영자 확정 묶음 confirm.json",
  "description": "<confirm_root>/<gu>/<confirm_id>/confirm.json. 운영자 대시보드가 쓰고 시민 길찾기(apply)가 읽는다. 카드 ID·승객 단위 정보 없음. docs/design/e2e-operator.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirm_id", "confirmed_at", "gu", "fleet", "strike", "run_id", "plan_id", "revision",
               "plan_sha256", "algo_name", "metrics", "m07", "code_commit", "input_sha256", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "confirm_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$"},
    "confirmed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+09:00$",
                     "description": "KST"},
    "gu": {"type": "string", "pattern": "^[a-z_]+$"},
    "fleet": {"type": "integer", "minimum": 1},
    "strike": {"type": "object", "additionalProperties": false, "required": ["mode", "ratio", "seed"],
               "properties": {"mode": {"enum": ["full", "ratio"]}, "ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                              "seed": {"type": "integer"}}},
    "run_id": {"type": "string", "description": "대시보드 실행 작업 ID(없으면 기본 곡선 'default')"},
    "plan_ref": {"type": "string", "description": "곡선 위 안 ID(pareto.json plans[].id)"},
    "plan_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "파이프라인 운행안 파일 해시(pareto.json plan_sha256)"},
    "algo_name": {"type": "string"},
    "service_date": {"type": "string", "description": "M05 시나리오 날짜(YYYY-MM-DD)"},
    "metrics": {"type": "object", "additionalProperties": false,
                "required": ["served_rate", "equity_far", "isolation", "refused_rate", "time_ratio_rode"],
                "properties": {"served_rate": {"type": ["number", "null"]}, "equity_far": {"type": ["number", "null"]},
                               "isolation": {"type": ["number", "null"]}, "refused_rate": {"type": ["number", "null"]},
                               "time_ratio_rode": {"type": ["number", "null"]}}},
    "m07": {"type": "object", "required": ["pass", "fully_verified", "failed_checks"],
            "properties": {"pass": {"const": true}, "fully_verified": {"type": "boolean"},
                           "failed_checks": {"type": "array", "maxItems": 0}, "days": {"type": "string"}}},
    "code_commit": {"type": ["string", "null"]},
    "input_sha256": {"type": ["string", "null"]},
    "precheck": {"type": "object"},
    "files": {"type": "object", "additionalProperties": false,
              "required": ["scenario", "plan", "timetable", "m07_report", "stops"],
              "properties": {
                "scenario": {"$ref": "#/$defs/file"}, "plan": {"$ref": "#/$defs/file"},
                "timetable": {"$ref": "#/$defs/file"}, "m07_report": {"$ref": "#/$defs/file"},
                "stops": {"$ref": "#/$defs/file"}}}
  },
  "$defs": {
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
             "properties": {"path": {"type": "string", "pattern": "^[a-z_]+\\.(json|csv)$"},
                            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
